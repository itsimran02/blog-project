# -----------------------------------------------------------------------------
# Next.js Blog CMS Environment Variables Example
# Copy this file to .env.local and fill in your secrets.
# -----------------------------------------------------------------------------

# Supabase Database & Auth Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Security & Key Encryption (Must be a 32-character string for AES-256-GCM)
LLM_KEY_ENCRYPTION_SECRET=your-32-character-secret-key-here

# Newsletter & Resend Email Configuration
RESEND_API_KEY=re_your_resend_api_key_here
RESEND_FROM_EMAIL=noreply@yourdomain.com
NEWSLETTER_DELAY_MINUTES=60
WEBHOOK_SECRET=your-shared-webhook-secret-here

# Cloudflare R2 Object Storage (Optional: Zero egress cost storage for images & media)
CLOUDFLARE_R2_ACCOUNT_ID=your_cloudflare_account_id
CLOUDFLARE_R2_ACCESS_KEY_ID=your_r2_access_key_id
CLOUDFLARE_R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
CLOUDFLARE_R2_BUCKET_NAME=blog-assets
NEXT_PUBLIC_CLOUDFLARE_R2_PUBLIC_URL=https://pub-xxxxxxxx.r2.dev

# Public App Base URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
